# Keep the build context small and prevent host artifacts leaking into images.
.git/
**/node_modules/
frontend/dist/
**/__pycache__/
**/*.pyc
**/.venv/
**/.pytest_cache/
*.log
*.err.log
*.out.log

# Large source downloads and raw snapshots are not needed to build images.
data/raw/
data/processed/
**/*.sqlite
