{"source_line": 5432, "reason": "missing canonical_smiles", "record": {"source": "ChEMBL", "source_record_id": "27394841", "activity_id": 27394841, "molecule_chembl_id": "CHEMBL5771551", "canonical_smiles": null, "assay_chembl_id": "CHEMBL5732981", "document_chembl_id": "CHEMBL5726605", "target_chembl_id": "CHEMBL2039", "target_organism": "Homo sapiens", "standard_type": "IC50", "standard_relation": "=", "original_standard_value": 65010.0, "original_standard_units": "nM", "standard_value_molar": 6.501e-05, "computed_pactivity": 4.18701983396052, "reported_pchembl_value": 4.19, "pchembl_consistent": true, "is_censored": false, "assay_context": {"target_chembl_id": "CHEMBL2039", "target_organism": "Homo sapiens", "standard_type": "IC50", "assay_type": "B", "bao_format": "BAO_0000357"}, "assay_context_key": "1944868c975637c4d98c", "data_validity_comment": null, "potential_duplicate": false, "raw_source": {"action_type": null, "activity_comment": "705153", "activity_id": 27394841, "activity_properties": [], "assay_chembl_id": "CHEMBL5732981", "assay_description": "Biological Assays-Inhibition of LSD1: Briefly, a fixed amount of LSD1 was incubated on ice for 15 minutes, in the absence and/or in the presence of at least eight 3-fold serial dilutions of the respective inhibitor (e.g., from 0 to 75 \u03bcM, depending on the inhibitor strength). Tranylcypromine (Biomol International) was used as a control for inhibition. Within the experiment, each concentration of inhibitor was tested in duplicate. After leaving the enzyme interacting with the inhibitor, KM of di-methylated H3-K4 peptide was added to each reaction and the experiment was left for 30 minutes at 37\u00b0 C. in the dark. The enzymatic reactions were set up in a 50 mM sodium phosphate, pH 7.4 buffer. At the end of the incubation, Amplex\u00ae Red reagent and horseradish peroxidase (HPR) solution were added to the reaction according to the recommendations provided by the supplier (Invitrogen), and left to incubate for 5 extra minutes at room temperature in the dark. A 1 \u03bcM H2O2 solution was used as a control of the kit efficiency. The conversion of the Amplex\u00ae Red reagent to resorufin due to the presence of H2O2 in the assay, was monitored by fluorescence (excitation at 540 nm, emission at 590 nm) using a microplate reader (Infinite 200, Tecan). Arbitrary units were used to measure level of H2O2 produced in the absence and/or in the presence of inhibitor.The maximum demethylase activity of LSD1 was obtained in the absence of inhibitor and corrected for background fluorescence in the absence of LSD1. The IC50 value of each inhibitor was calculated with GraphPad Prism Software.", "assay_type": "B", "assay_variant_accession": null, "assay_variant_mutation": null, "bao_endpoint": "BAO_0000190", "bao_format": "BAO_0000357", "bao_label": "single protein format", "canonical_smiles": null, "data_validity_comment": null, "data_validity_description": null, "document_chembl_id": "CHEMBL5726605", "document_journal": null, "document_year": 2019, "ligand_efficiency": null, "modality": null, "molecule_chembl_id": "CHEMBL5771551", "molecule_pref_name": null, "parent_molecule_chembl_id": "CHEMBL5771551", "pchembl_value": "4.19", "potential_duplicate": 0, "qudt_units": "http://www.openphacts.org/units/Nanomolar", "record_id": 4295184, "relation": "=", "src_id": 37, "standard_flag": 1, "standard_relation": "=", "standard_text_value": null, "standard_type": "IC50", "standard_units": "nM", "standard_upper_value": null, "standard_value": "65010.0", "target_chembl_id": "CHEMBL2039", "target_organism": "Homo sapiens", "target_pref_name": "Amine oxidase [flavin-containing] B", "target_tax_id": "9606", "text_value": null, "toid": null, "type": "IC50", "units": "nM", "uo_units": "UO_0000065", "upper_value": null, "value": "65010.0"}}}
