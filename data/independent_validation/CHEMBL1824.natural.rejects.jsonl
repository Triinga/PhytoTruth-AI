er (available from PerkinElmer Life and Analytical Sciences, Inc., of Boston Mass.).", "assay_type": "B", "assay_variant_accession": null, "assay_variant_mutation": null, "bao_endpoint": "BAO_0000190", "bao_format": "BAO_0000357", "bao_label": "single protein format", "canonical_smiles": null, "data_validity_comment": null, "data_validity_description": null, "document_chembl_id": "CHEMBL5726547", "document_journal": null, "document_year": 2017, "ligand_efficiency": null, "modality": null, "molecule_chembl_id": "CHEMBL5786349", "molecule_pref_name": null, "parent_molecule_chembl_id": "CHEMBL5786349", "pchembl_value": "6.28", "potential_duplicate": 0, "qudt_units": "http://www.openphacts.org/units/Nanomolar", "record_id": 4287895, "relation": "=", "src_id": 37, "standard_flag": 1, "standard_relation": "=", "standard_text_value": null, "standard_type": "IC50", "standard_units": "nM", "standard_upper_value": null, "standard_value": "525.0", "target_chembl_id": "CHEMBL1824", "target_organism": "Homo sapiens", "target_pref_name": "Receptor tyrosine-protein kinase erbB-2", "target_tax_id": "9606", "text_value": null, "toid": null, "type": "IC50", "units": "nM", "uo_units": "UO_0000065", "upper_value": null, "value": "525.0"}}}
